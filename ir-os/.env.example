# ============================================================
# IR-OS Environment Configuration
# ============================================================
# NEVER commit .env to version control
# Copy this file to .env and fill in values

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-6
ANTHROPIC_MAX_TOKENS=8192

# --- Database (SQLite path or PostgreSQL DSN) ---
DATABASE_URL=./data/ir-os.db

# --- Audit log (append-only file path) ---
AUDIT_LOG_PATH=./data/audit/audit.jsonl

# --- API Security ---
JWT_SECRET=change-me-to-a-strong-random-secret
API_PORT=3000

# --- Human Approval Webhook (Slack / email / internal system) ---
APPROVAL_WEBHOOK_URL=https://hooks.example.com/ir-approvals
APPROVAL_EMAIL_TO=ir-team@company.com

# --- CVM / SEC Filing endpoints (internal proxy or real) ---
CVM_FILING_ENDPOINT=https://www.rad.cvm.gov.br/ENET/frmUploadArquivo.aspx
SEC_EDGAR_ENDPOINT=https://efts.sec.gov/LATEST/search-index

# --- IR Website CMS (headless CMS API) ---
CMS_API_URL=https://cms.company.com/api
CMS_API_KEY=cms-key-...

# --- Data Classification ---
# PUBLIC | INTERNAL_APPROVED | DRAFT_INTERNAL | PROHIBITED
DEFAULT_CLASSIFICATION=DRAFT_INTERNAL

# --- Feature Flags ---
ENABLE_AUTO_CONSENSUS_REFRESH=true
ENABLE_PEER_MONITORING=true
ENABLE_WEBSITE_AUTOPUBLISH=false   # always false in production
