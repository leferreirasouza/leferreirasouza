{
  "name": "ir-os",
  "version": "0.1.0",
  "description": "AI-native Investor Relations Operating System — multi-agent platform for Brazil-listed / dual-listed companies",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/api/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/api/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/data/migrations/run.ts",
    "db:seed": "tsx scripts/seed-company.ts",
    "ingest:web": "tsx scripts/ingest-ir-website.ts",
    "ingest:file": "tsx scripts/ingest-documents.ts",
    "ingest:status": "tsx scripts/ingest-status.ts",
    "setup": "tsx scripts/setup.ts",
    "audit:export": "tsx src/audit/export.ts",
    "refresh:reference": "tsx scripts/refresh-reference-library.ts",
    "seed:reference": "tsx scripts/seed-reference-library.ts",
    "company:add": "tsx scripts/add-company.ts",
    "ui:install": "cd frontend && npm install",
    "ui:dev": "cd frontend && npm run dev",
    "ui:build": "cd frontend && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "express": "^4.19.2",
    "zod": "^3.23.8",
    "uuid": "^10.0.0",
    "date-fns": "^3.6.0",
    "winston": "^3.13.0",
    "better-sqlite3": "^11.1.2",
    "dotenv": "^16.4.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "pdf-parse": "^1.1.1",
    "mammoth": "^1.8.0",
    "xlsx": "^0.18.5",
    "axios": "^1.7.2",
    "cheerio": "^1.0.0",
    "multer": "^1.4.5-lts.1",
    "p-limit": "^5.0.0",
    "cli-progress": "^3.12.0",
    "chalk": "^5.3.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/better-sqlite3": "^7.6.10",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/uuid": "^10.0.0",
    "@types/multer": "^1.4.11",
    "@types/pdf-parse": "^1.1.4",
    "@types/cli-progress": "^3.11.5",
    "@types/prompts": "^2.4.9",
    "tsx": "^4.15.5",
    "typescript": "^5.5.2",
    "vitest": "^1.6.0",
    "eslint": "^9.5.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0"
  }
}
